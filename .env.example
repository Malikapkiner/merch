# Neon connection string (pooled). Copy to .env.local and fill in.
DATABASE_URL=
# Real Postgres used by tests; never point this at Neon production data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/merch_test
# Admin account created by `pnpm db:seed` (skipped when the e-posta already exists). Min 8 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudflare R2 (product images). All five are needed together; none means uploads are disabled.
# Images are served from R2_PUBLIC_BASE_URL (a bucket domain or custom domain), which also
# feeds the Next.js image optimizer allowlist.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Payment provider. With all three IYZICO_ variables set, card payments go through iyzico's hosted
# checkout form; none set means the in-memory fake (test payment page at /odeme/sahte) outside production.
# PAYMENT_PROVIDER=fake forces the fake, also in a production build (E2E only, never on the live store).
PAYMENT_PROVIDER=
# iyzico API keys (merchant panel > Ayarlar). Sandbox: https://sandbox-api.iyzipay.com, live: https://api.iyzipay.com.
# iyzico posts the Customer back to https://<host>/odeme/sonuc, so the store must be reachable over HTTPS
# (use a tunnel for local sandbox testing). Set the merchant notification URL to https://<host>/odeme/bildirim.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
